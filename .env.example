# Copy to .env.local for local development. Never commit real secrets.
# All values are validated by lib/env.ts.

# Canonical production origin, no trailing slash.
# TODO(client): confirm domain. Planned: https://www.rudrahimalayantrails.com
NEXT_PUBLIC_SITE_URL=

# Netlify sets CONTEXT automatically (production | deploy-preview | branch-deploy | dev).
# Only set it locally to test indexing. The site is indexable only when
# CONTEXT=production AND NEXT_PUBLIC_SITE_URL is set.
CONTEXT=

# Image loader: "netlify" uses the Netlify Image CDN, "none" serves files as they are.
NEXT_PUBLIC_IMAGE_LOADER=none

# Set to 1 to make check-data fail on any remaining TODO (release gate).
CONTENT_STRICT=
